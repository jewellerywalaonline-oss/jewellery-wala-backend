[TEMPLATE]
# ── API Server Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ───────────────────────────────────────────────────────────────────────

# Server port (default: 5000)
PORT=5000

# JWT secret for signing access tokens (REQUIRED — generate a strong one)
JWT_SECRET=your-jwt-secret-here

# Node environment (development / production / test)
NODE_ENV=development

# MongoDB connection string (REQUIRED)
NEW_DB_URL=mongodb://localhost:27017/jewelley_walla

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# The web frontend and admin panel URLs should be listed here.
# Default: http://localhost:3000,http://localhost:3001
# Examples:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:3001
#   CORS_ORIGINS=https://jewellerywalla.com,https://admin.jewellerywalla.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── URLs ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ── Email (Nodemailer) ───────────────────────────────────────────────
MY_GMAIL=your-email@gmail.com
MY_GMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=Jewellery Walla
APP_NAME=Jewellery Walla
SUPPORT_EMAIL=support@jewellerywalla.com

# ── Cloudflare R2 (file uploads) ─────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
R2_API_TOKEN=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URL=
CDN_HOST=cdn.jewellerywalla.com

# ── Razorpay (payments) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (alternative email provider) ──────────────────────────────
RESEND_API_KEY=



# ── Google OAuth (social login) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI Provider Configuration ────────────────────────────────────────
# Select the AI provider: "gemini" (default) or "openrouter"
# Gemini requires GEMINI_API_KEY; OpenRouter requires OPENROUTER_API_KEY.
AI_PROVIDER=gemini

# ── Google Gemini AI ──────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── OpenRouter AI ────────────────────────────────────────────────────
# OpenAI-compatible gateway with many free and paid models.
# Get your API key at: https://openrouter.ai/keys
# Use "openrouter/free" for free tier, or any model ID like "openai/gpt-4o".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── AI Daily Budget ──────────────────────────────────────────────────
AI_DAILY_TOKEN_BUDGET=100000


